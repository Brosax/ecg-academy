# Copy to .env.local for `npm run dev` (Vite), or to .dev.vars for `npm run cf:dev` (wrangler). Both are git-ignored.
# In production the key is a Cloudflare secret: npx wrangler secret put ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
# Optional: the model the site's assistant uses (default claude-opus-5-5)
# ASSISTANT_MODEL=claude-opus-5-5
# Optional: extra browser origins allowed to call /api/assistant, comma-separated (default: the site itself)
# ALLOWED_ORIGINS=https://www.example.com,https://example.com
